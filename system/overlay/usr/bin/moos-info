#!/bin/sh

set -eu

case "${1:-}" in
    '')
        ;;
    -h|--help)
        printf 'Usage: moos-info\n'
        exit 0
        ;;
    *)
        echo 'Usage: moos-info' >&2
        exit 2
        ;;
esac

if [ ! -r /etc/moos-release ]; then
    echo 'moos-info: /etc/moos-release is missing' >&2
    exit 1
fi

. /etc/moos-release

kernel=$(uname -r 2>/dev/null || printf '?')
arch=$(uname -m 2>/dev/null || printf '?')
hostname_value=$(hostname 2>/dev/null || printf '?')
ram=$(awk '/^MemTotal:/ {printf "%d MiB", $2 / 1024; exit}' /proc/meminfo 2>/dev/null)
uptime=$(awk '{total=int($1); days=int(total / 86400); hours=int((total % 86400) / 3600); mins=int((total % 3600) / 60); printf "%dd %02dh %02dm", days, hours, mins; exit}' /proc/uptime 2>/dev/null)
rootfs=$(df -h / 2>/dev/null | awk 'NR == 2 {print $3 " used / " $2; exit}')
ipv4=$(ip -4 addr show scope global 2>/dev/null | awk '/inet / {sub("/.*", "", $2); print $2; exit}')

[ -n "$ram" ] || ram='?'
[ -n "$uptime" ] || uptime='?'
[ -n "$rootfs" ] || rootfs='?'

if [ -n "$ipv4" ]; then
    network="online ($ipv4)"
else
    network='offline'
fi

printf 'MOOS info\n'
printf 'version: %s %s\n' "$MOOS_NAME" "$MOOS_VERSION"
printf 'hostname: %s\n' "$hostname_value"
printf 'kernel: %s\n' "$kernel"
printf 'arch: %s\n' "$arch"
printf 'uptime: %s\n' "$uptime"
printf 'memory: %s\n' "$ram"
printf 'rootfs: %s\n' "$rootfs"
printf 'network: %s\n' "$network"
