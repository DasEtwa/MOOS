From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MOOS maintainers <moos@example.invalid>
Date: Sat, 22 Aug 2026 17:50:00 +0200
Subject: [PATCH] package: update QEMU and enable host seccomp for MOOS

MOOS runs host QEMU as part of its guest boundary. Keep the QEMU maintenance
release current within the stable Buildroot pin and build the host emulator
with its optional Linux seccomp support. The host libseccomp copy is kept
separate from the target package so the generated guest image does not gain a
new runtime dependency.

This is a MOOS-local Buildroot patch and is applied by scripts/build.sh after
the documented Buildroot release checkout.
---
 package/libseccomp/libseccomp.mk | 3 +++
 package/qemu/qemu.hash           | 2 +-
 package/qemu/qemu.mk             | 10 +++++++++-
 3 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/package/libseccomp/libseccomp.mk b/package/libseccomp/libseccomp.mk
index 26585b18..85193b62 100644
--- a/package/libseccomp/libseccomp.mk
+++ b/package/libseccomp/libseccomp.mk
@@ -11,4 +11,7 @@ LIBSECCOMP_CPE_ID_VALID = YES
 LIBSECCOMP_INSTALL_STAGING = YES
 LIBSECCOMP_DEPENDENCIES = host-gperf
 
+HOST_LIBSECCOMP_DEPENDENCIES = host-gperf
+
 $(eval $(autotools-package))
+$(eval $(host-autotools-package))
diff --git a/package/qemu/qemu.hash b/package/qemu/qemu.hash
index f8e75022..fd62ff59 100644
--- a/package/qemu/qemu.hash
+++ b/package/qemu/qemu.hash
@@ -1,4 +1,4 @@
 # Locally computed, tarball verified with GPG signature
-sha256  9e30ad1b8b9f7b4463001582d1ab297f39cfccea5d08540c0ca6d6672785883a  qemu-10.2.0.tar.xz
+sha256  da5fcffc32762820568b828ed430a728864d34d50b6d2f30358597760cbb0523  qemu-11.0.3.tar.xz
 sha256  dd3ce02338c3a48abb6ba59b48809f7108a8bd242cb0cc8be90daafa30707c28  COPYING
 sha256  31c90ce76b6f5aab90a205851e71d5c27e31c0aa3d7017a4383b98a6fe3f1faa  COPYING.LIB
diff --git a/package/qemu/qemu.mk b/package/qemu/qemu.mk
index b7007e3b..a8c44b67 100644
--- a/package/qemu/qemu.mk
+++ b/package/qemu/qemu.mk
@@ -6,6 +6,6 @@
 # When updating the version, check whether the list of supported targets
 # needs to be updated.
-QEMU_VERSION = 10.2.0
+QEMU_VERSION = 11.0.3
 QEMU_SOURCE = qemu-$(QEMU_VERSION).tar.xz
 QEMU_SITE = https://download.qemu.org
 QEMU_SELINUX_MODULES = qemu virt
@@ -372,8 +372,16 @@ HOST_QEMU_DEPENDENCIES = \
 	host-pkgconf \
 	host-python3 \
 	host-python-distlib \
+	host-python-setuptools \
+	host-python-wheel \
 	host-slirp \
 	host-zlib
+ifeq ($(shell uname -s),Linux)
+HOST_QEMU_DEPENDENCIES += host-libseccomp
+HOST_QEMU_OPTS += --enable-seccomp
+else
+HOST_QEMU_OPTS += --disable-seccomp
+endif
 
 #       BR ARCH         qemu
 #       -------         ----
