#!/usr/bin/env python3
"""Small local client for the MOOS daemon."""

from __future__ import annotations

import argparse
import hashlib
import ipaddress
import platform
import re
import selectors
import shutil
import stat
import subprocess
import time
import textwrap
from dataclasses import asdict, dataclass
import codecs
import signal
import termios
import tty
import json
import os
import select
import socket
import sys
from collections import deque
from contextlib import contextmanager
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
SCRIPT_ROOT = Path(__file__).resolve().parent
if (SCRIPT_ROOT / "moos_protocol.py").is_file():
    MODULE_ROOT = SCRIPT_ROOT
else:
    MODULE_ROOT = REPO_ROOT / "host"
if not MODULE_ROOT.is_dir():
    MODULE_ROOT = Path("/usr/lib/moos")
sys.path.insert(0, str(MODULE_ROOT))

from moos_protocol import (  # noqa: E402
    ByteTransport,
    ControlFailure,
    ControlSuccess,
    FrameDecoder,
    FrameResult,
    TerminalError,
    TerminalOutput,
    encode_frame,
    make_control_request,
    make_terminal_close,
    make_terminal_input,
    parse_control_response,
    parse_terminal_response,
)


DEFAULT_SOCKET = Path("/run/moos/moosd.sock")
READ_BYTES = 4096


HELP = """MOOS — tiny. green. alive.

Personal MOOS is your small Linux home on this computer.

  moos setup            See what is ready and what to do next
  moos doctor           Find out what needs attention
  moos status --human   See whether Personal MOOS is running
  moos start            Start Personal MOOS
  moos stop             Stop Personal MOOS
  moos shell            Open Personal MOOS's console (login required)
  moos help             Show this guide

New here? Start with moos setup. These checks do not change your settings.
Your iPhone can view status; start, stop and shell work on this computer.
Guest login details: moos setup --explain local

For scripts: moos status returns JSON; moos doctor --report returns a JSON report.
Explicit forms remain: moos personal status|start|stop|terminal.
More detail: moos doctor --verbose. Plain text: --no-color (or NO_COLOR).
"""


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="moos", description=HELP,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--socket", type=Path, default=DEFAULT_SOCKET,
                        help="advanced: select the local control socket")
    parser.add_argument("command", nargs="?", default="help", choices=(
        "setup", "doctor", "help", "status", "start", "stop", "shell", "personal"))
    parser.add_argument("action", nargs="?", choices=("status", "start", "stop", "terminal"))
    parser.add_argument("--human", action="store_true", help="readable lifecycle/status output")
    parser.add_argument("--verbose", action="store_true", help="setup/doctor: show individual technical observations")
    parser.add_argument("--no-color", action="store_true", help="use plain text status labels without emoji")
    parser.add_argument("--report", action="store_true", help="doctor: curated JSON, no raw diagnostics")
    parser.add_argument("--remote", action="store_true", help="setup/doctor: require remote status checks")
    parser.add_argument("--non-interactive", action="store_true", help="setup: do not prompt; local by default")
    parser.add_argument("--explain", choices=("trust", "local", "remote"), help="setup: explain a next step")
    parser.add_argument("--expect-fingerprint", type=fingerprint_argument,
                        help="setup/doctor: expected public-key SHA-256 DER fingerprint from a trusted source")
    args = parser.parse_args()
    diagnostic = args.command in {"setup", "doctor"}
    if args.action is not None and args.command != "personal":
        parser.error("only personal accepts an action")
    if (args.remote or args.expect_fingerprint) and not diagnostic:
        parser.error("--remote and --expect-fingerprint require setup or doctor")
    if args.verbose and not diagnostic:
        parser.error("--verbose requires setup or doctor")
    if args.verbose and args.report:
        parser.error("choose --verbose for text or --report for JSON")
    if args.report and args.command != "doctor":
        parser.error("--report requires doctor")
    if (args.explain or args.non_interactive) and args.command != "setup":
        parser.error("--explain and --non-interactive require setup")
    if args.human and args.command not in {"status", "personal", "start", "stop"}:
        parser.error("--human requires a status or lifecycle command")
    return args


def fingerprint_argument(value: str) -> str:
    if not re.fullmatch(r"[0-9a-fA-F]{64}", value):
        raise argparse.ArgumentTypeError("use exactly 64 hexadecimal SHA-256 digits")
    return value.lower()


def operation_for(args: argparse.Namespace) -> str:
    if args.command in {"start", "stop"}:
        return f"personal.{args.command}"
    if args.command == "status":
        return "status"
    if args.action is None:
        raise ValueError("personal requires status, start, stop, or terminal")
    return f"personal.{args.action}"


def _receive_frame(
    connection: ByteTransport,
    decoder: FrameDecoder,
    pending: deque[FrameResult],
    deadline: float | None = None,
) -> dict:
    while True:
        while pending:
            result = pending.popleft()
            if result.error is not None or result.frame is None:
                raise ValueError("daemon sent an invalid protocol frame")
            return result.frame
        if deadline is not None:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError("control response timed out")
            connection.settimeout(remaining)
        data = connection.recv(READ_BYTES)
        if not data:
            final = decoder.finish()
            if final is not None:
                raise ValueError("daemon sent a truncated protocol frame")
            raise ConnectionError("daemon closed before sending a response")
        pending.extend(decoder.feed(data))


def request(socket_path: Path, operation: str, *, timeout: float | None = None) -> ControlSuccess | ControlFailure:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        deadline = time.monotonic() + timeout if timeout is not None else None
        connection.settimeout(timeout)
        connection.connect(str(socket_path))
        connection.sendall(
            encode_frame(make_control_request(operation))
        )
        frame = _receive_frame(connection, FrameDecoder(), deque(), deadline)
        return parse_control_response(frame, expected_operation=operation)


def _write_terminal_frame(frame: dict) -> bool:
    terminal_frame = parse_terminal_response(frame)
    if isinstance(terminal_frame, TerminalOutput):
        sys.stdout.write(terminal_frame.data)
        sys.stdout.flush()
        return True
    if isinstance(terminal_frame, TerminalError):
        print(f"moos: terminal error: {terminal_frame.code}", file=sys.stderr)
        return False
    raise ValueError("daemon sent an invalid terminal frame")


@contextmanager
def raw_terminal():
    fd = sys.stdin.fileno()
    if not os.isatty(fd):
        yield
        return
    previous = termios.tcgetattr(fd)
    handlers = {}

    def interrupted(signum, frame):
        raise SystemExit(128 + signum)

    try:
        for signum in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
            handlers[signum] = signal.signal(signum, interrupted)
        tty.setraw(fd)
        yield
    finally:
        try:
            termios.tcsetattr(fd, termios.TCSANOW, previous)
        finally:
            for signum, handler in handlers.items():
                signal.signal(signum, handler)


def terminal(socket_path: Path) -> int:
    with raw_terminal():
        return _terminal(socket_path)


def _terminal(socket_path: Path) -> int:
    input_decoder = codecs.getincrementaldecoder("utf-8")(errors="replace")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.connect(str(socket_path))
        connection.sendall(
            encode_frame(make_control_request("personal.terminal.open"))
        )
        decoder = FrameDecoder()
        pending: deque[FrameResult] = deque()
        acknowledgment = parse_control_response(
            _receive_frame(connection, decoder, pending),
            expected_operation="personal.terminal.open",
        )
        if isinstance(acknowledgment, ControlFailure):
            print(
                f"moos: {acknowledgment.code}: {acknowledgment.message}",
                file=sys.stderr,
            )
            return 1
        while True:
            while pending:
                result = pending.popleft()
                if result.error is not None or result.frame is None:
                    raise ValueError("daemon sent an invalid terminal frame")
                if not _write_terminal_frame(result.frame):
                    return 1
            readable, _, _ = select.select([sys.stdin, connection], [], [])
            if sys.stdin in readable:
                data = os.read(sys.stdin.fileno(), 2048)
                text = input_decoder.decode(data, final=not data)
                if text:
                    connection.sendall(encode_frame(make_terminal_input(text)))
                if not data:
                    connection.sendall(encode_frame(make_terminal_close()))
                    return 0
            if connection in readable:
                data = connection.recv(READ_BYTES)
                if not data:
                    final = decoder.finish()
                    if final is not None:
                        raise ValueError("daemon sent a truncated terminal frame")
                    return 0
                pending.extend(decoder.feed(data))
                while pending:
                    result = pending.popleft()
                    if result.error is not None or result.frame is None:
                        raise ValueError("daemon sent an invalid terminal frame")
                    if not _write_terminal_frame(result.frame):
                        return 1


# Keep operator checks in the existing installed client: no new privileged
# bundle member or import is needed. Probes never authorize an installation.
@dataclass(frozen=True)
class Check:
    id: str
    area: str
    state: str  # ok, issue, unknown, info
    summary: str
    next_step: str = ""


